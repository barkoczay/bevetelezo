# Railway automatikusan beállítja a Postgres addonból
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# KÖTELEZŐ megváltoztatni! Generálás: openssl rand -hex 32
JWT_SECRET=valtsd-meg-productionben
JWT_EXPIRE_HOURS=12

# A frontend origin(je). Élesben add meg a saját domaint,
# pl. https://bevetelezo.onixcom.hu — fejlesztéskor lehet '*'
CORS_ORIGINS=*

# Naturasoft alapértelmezett raktár
DEFAULT_WAREHOUSE=Szüret utca
